rules_version = '2';
// Sawee Rxfill Firestore Rules v6.6 — v6.5 + ผู้เบิกแก้ผู้ลงนามท้ายใบ (sign_people) ได้ทุกสถานะ
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function isActiveUser() {
      return hasProfile() && profile().get('active', true) != false;
    }

    function isAdminRole(role) {
      return role == 'admin'
          || role == 'Admin'
          || role == 'ADMIN'
          || role == 'administrator';
    }

    function isHospitalRole(role) {
      return role == 'hospital'
          || role == 'Hospital'
          || role == 'HOSPITAL'
          || role == 'รพ.สต.'
          || role == 'รพสต';
    }

    // v5.7: หน่วยงานภายใน รพ. และ ห้องยา
    function isDeptRole(role) {
      return role == 'dept' || role == 'Dept' || role == 'department' || role == 'หน่วยงาน';
    }

    function isPharmacyRole(role) {
      return role == 'pharmacy' || role == 'Pharmacy' || role == 'ห้องยา';
    }

    function isInternalUser() {
      return isActiveUser() && (isDeptRole(profile().role) || isPharmacyRole(profile().role));
    }

    function isPharmacyUser() {
      return isActiveUser() && isPharmacyRole(profile().role);
    }

    function ownsDept(deptId) {
      return isInternalUser()
          && profile().get('dept_id', '') is string
          && profile().get('dept_id', '') != ''
          && profile().dept_id == deptId;
    }

    function isAdmin() {
      return isActiveUser() && isAdminRole(profile().role);
    }

    function isHospitalUser() {
      return isActiveUser() && isHospitalRole(profile().role);
    }

    function ownsHospital(hospitalId) {
      return isHospitalUser()
          && profile().hospital_id is string
          && profile().hospital_id == hospitalId;
    }

    match /master_hospitals/{docId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // รพ.สต. ตั้งค่าตำแหน่งผู้ลงนามประจำของตัวเองได้ (แก้ได้เฉพาะฟิลด์นี้)
      allow update: if isAdmin()
                    || (ownsHospital(resource.data.get('hospital_id', docId))
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['sign_roles', 'sign_roles_updated_at', 'updated_at'])
                        && request.resource.data.sign_roles is list
                        && request.resource.data.sign_roles.size() <= 8);
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.get('active', true) != false
                    && request.resource.data.email == request.auth.token.email
                    && (
                      (isHospitalRole(request.resource.data.role)
                        && request.resource.data.hospital_id is string)
                      || ((isDeptRole(request.resource.data.role)
                           || isPharmacyRole(request.resource.data.role))
                        && request.resource.data.dept_id is string
                        && request.resource.data.dept_id != ''
                        && exists(/databases/$(database)/documents/master_depts/$(request.resource.data.dept_id)))
                    );

      allow update: if isAdmin()
                    || (isActiveUser()
                        && request.auth.uid == userId
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name', 'position', 'updated_at']));

      allow delete: if isAdmin();
    }

    match /master_drugs/{docId} {
      allow read: if isActiveUser();

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
                    || (isHospitalUser()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['fuzzy', 'updated_at']))
                    || (isPharmacyUser()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['hosxp_multiplier', 'hosxp_multiplier_updated_at', 'hosxp_multiplier_updated_by', 'updated_at']));
    }

    match /master_unit/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /config_par/{docId} {
      allow read: if isAdmin() || ownsHospital(resource.data.hospital_id);

      allow create: if isAdmin()
                    || (ownsHospital(request.resource.data.hospital_id)
                        && request.resource.data.drug_id is string
                        && request.resource.data.par_qty is number
                        && request.resource.data.par_qty >= 0);

      allow update: if isAdmin()
                    || (ownsHospital(resource.data.hospital_id)
                        && request.resource.data.hospital_id == resource.data.hospital_id
                        && request.resource.data.drug_id == resource.data.drug_id
                        && request.resource.data.par_qty is number
                        && request.resource.data.par_qty >= 0
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['par_qty', 'updated_at']));

      allow delete: if isAdmin() || ownsHospital(resource.data.hospital_id);
    }

    match /current_excess/{docId} {
      allow read: if isAdmin() || ownsHospital(resource.data.hospital_id);

      allow create: if isAdmin()
                    || (ownsHospital(request.resource.data.hospital_id)
                        && request.resource.data.drug_id is string
                        && request.resource.data.excess_balance is number);

      allow update: if isAdmin()
                    || (ownsHospital(resource.data.hospital_id)
                        && request.resource.data.hospital_id == resource.data.hospital_id
                        && request.resource.data.drug_id == resource.data.drug_id
                        && request.resource.data.excess_balance is number
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['excess_balance', 'last_updated']));

      allow delete: if isAdmin()
                    || (ownsHospital(resource.data.hospital_id)
                        && resource.data.excess_balance == 0);
    }

    match /requisitions/{reqId} {
      allow read: if isAdmin() || ownsHospital(resource.data.hospitalId);

      allow create: if isAdmin()
                    || (ownsHospital(request.resource.data.hospitalId)
                        && (request.resource.data.status == 'Draft'
                            || request.resource.data.status == 'Pending')
                        && request.resource.data.created_by_uid == request.auth.uid
                        && request.resource.data.month is number
                        && request.resource.data.year is number);

      allow update: if isAdmin()
                    || (ownsHospital(resource.data.hospitalId)
                        && (
                          (resource.data.status == 'Draft'
                            && (request.resource.data.status == 'Draft'
                                || request.resource.data.status == 'Pending'))
                          || ((resource.data.status == 'Pending'
                               || resource.data.status == 'Rejected')
                              && request.resource.data.status == 'Pending')
                        )
                        && request.resource.data.hospitalId == resource.data.hospitalId
                        && request.resource.data.month == resource.data.month
                        && request.resource.data.year == resource.data.year
                        && request.resource.data.get('created_by_uid', '')
                             == resource.data.get('created_by_uid', ''))
                    || (ownsHospital(resource.data.hospitalId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['is_printed', 'printed_at',
                                       'printed_by_uid', 'printed_by_name', 'updated_at'])
                        && request.resource.data.printed_by_uid == request.auth.uid)
                    // ตำแหน่งผู้ลงนามท้ายใบ แก้ได้ทุกสถานะ (ไม่กระทบจำนวนยา)
                    || (ownsHospital(resource.data.hospitalId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['sign_roles', 'sign_roles_updated_at', 'sign_roles_updated_by', 'updated_at'])
                        && request.resource.data.sign_roles is list
                        && request.resource.data.sign_roles.size() <= 8);

      allow delete: if isAdmin()
                    || (ownsHospital(resource.data.hospitalId)
                        && (resource.data.status == 'Draft'
                            || resource.data.status == 'Pending'
                            || resource.data.status == 'Rejected'));
    }

    match /historical_usages/{docId} {
      allow read: if isAdmin() || ownsHospital(resource.data.hospital_id);
      allow write: if isAdmin();
    }

    match /stock_adjustments/{docId} {
      allow read: if isAdmin() || ownsHospital(resource.data.hospital_id);

      allow create: if isAdmin()
                    || (ownsHospital(request.resource.data.hospital_id)
                        && request.resource.data.status == 'Pending'
                        && request.resource.data.user_uid == request.auth.uid
                        && request.resource.data.old_balance is number
                        && request.resource.data.new_balance is number
                        && request.resource.data.new_balance >= 0
                        && request.resource.data.reason is string);

      allow update, delete: if isAdmin();
    }

    match /stock_returns/{docId} {
      allow read: if isAdmin() || ownsHospital(resource.data.hospital_id);

      allow create: if isAdmin()
                    || (ownsHospital(request.resource.data.hospital_id)
                        && request.resource.data.status == 'Completed'
                        && request.resource.data.created_by_uid == request.auth.uid
                        && request.resource.data.totalValue is number);

      allow update, delete: if isAdmin();
    }

    match /audit_logs/{docId} {
      allow create: if isActiveUser()
                    && request.resource.data.actor_uid == request.auth.uid;

      allow read: if isAdmin()
                  || (isActiveUser()
                      && resource.data.actor_uid == request.auth.uid);

      allow update, delete: if false;
    }


    // INVS lot/expiry snapshots are written only by the server-side service account.
    // Hospital users can read ONLY their own mapped hospital. No client writes are allowed.
    match /invs_stock_lots/{docId} {
      allow read: if isAdmin() || ownsHospital(resource.data.hospital_id);
      allow create, update, delete: if false;
    }

    match /invs_stock_meta/{hospitalId} {
      allow read: if isAdmin()
                  || (isHospitalUser()
                      && profile().hospital_id is string
                      && profile().hospital_id == hospitalId);
      allow create, update, delete: if false;
    }


    // Sawee VMI Virtual Stock: Firebase is the working stock ledger.
    // INVS remains read-only reference and is never modified by these client rules.
    match /vmi_virtual_lots/{docId} {
      allow read: if isAdmin() || ownsHospital(resource.data.hospital_id);

      // Baseline/receipt documents are created only by the server-side service account.
      // Hospital users may Adjust quantity of an existing lot in their own hospital only.
      allow create, delete: if false;
      allow update: if isAdmin()
                    || (ownsHospital(resource.data.hospital_id)
                        && request.resource.data.hospital_id == resource.data.hospital_id
                        && request.resource.data.drug_id == resource.data.drug_id
                        && request.resource.data.get('lot_no', '') == resource.data.get('lot_no', '')
                        && request.resource.data.get('expiry', '') == resource.data.get('expiry', '')
                        && request.resource.data.get('source_type', '') == resource.data.get('source_type', '')
                        && request.resource.data.remaining_qty is number
                        && request.resource.data.remaining_qty >= 0
                        && request.resource.data.active is bool
                        && request.resource.data.manual_adjusted_by_uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'remaining_qty', 'active', 'manual_adjusted_at',
                          'manual_adjusted_by_uid', 'manual_adjusted_by_name',
                          'manual_adjust_reason', 'updated_at'
                        ]));
    }

    match /vmi_stock_events/{docId} {
      allow read: if isAdmin() || ownsHospital(resource.data.hospital_id);

      // Automatic FEFO and INVS receipt events are server-only.
      // Hospital users can create only a MANUAL_ADJUST event for their own hospital.
      allow create: if isAdmin()
                    || (ownsHospital(request.resource.data.hospital_id)
                        && (request.resource.data.event_type == 'MANUAL_ADJUST'
                            || request.resource.data.event_type == 'STOCK_RETURN')
                        && request.resource.data.actor_uid == request.auth.uid
                        && request.resource.data.qty_delta is number
                        && request.resource.data.before_qty is number
                        && request.resource.data.after_qty is number
                        && request.resource.data.after_qty >= 0
                        && request.resource.data.reason is string);
      allow update, delete: if false;
    }

    match /vmi_stock_meta/{hospitalId} {
      allow read: if isAdmin()
                  || (isHospitalUser()
                      && profile().hospital_id is string
                      && profile().hospital_id == hospitalId);
      allow create, update, delete: if false;
    }


    // ===== ระบบวัคซีน ว.3/1 =====
    // เป็นเอกสารช่วยพิมพ์เท่านั้น ไม่ผูกกับสต็อกหรือ INVS
    // 1 ใบต่อ รพ.สต. ต่อเดือน (บังคับด้วย document id รูปแบบ VAC-<hospital>-<year>-<month>)
    match /vaccine_requisitions/{docId} {
      allow read: if isAdmin() || ownsHospital(resource.data.hospitalId);

      allow create: if isAdmin()
                    || (ownsHospital(request.resource.data.hospitalId)
                        && request.resource.data.created_by_uid == request.auth.uid
                        && request.resource.data.month is number
                        && request.resource.data.year is number
                        && request.resource.data.form_kind == 'vaccine_w31');

      allow update: if isAdmin()
                    || (ownsHospital(resource.data.hospitalId)
                        && request.resource.data.hospitalId == resource.data.hospitalId
                        && request.resource.data.month == resource.data.month
                        && request.resource.data.year == resource.data.year);

      // เจ้าของใบลบใบของตัวเองได้ (ผู้ดูแลระบบลบได้ทุกใบ)
      allow delete: if isAdmin() || ownsHospital(resource.data.hospitalId);
    }

    // ===== v5.7 หน่วยงาน / ห้องยา ภายใน รพ. =====
    match /master_depts/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ใบเบิกภายใน: ผู้ใช้สร้างเป็น Pending → admin ตรวจ/อนุมัติ/ส่ง INVS ตามลำดับคิว
    match /internal_requisitions/{reqId} {
      allow read: if isAdmin() || ownsDept(resource.data.deptId);

      allow create: if isAdmin()
                    || (ownsDept(request.resource.data.deptId)
                        && (request.resource.data.status == 'Pending' || request.resource.data.status == 'Draft')
                        && request.resource.data.created_by_uid == request.auth.uid
                        && request.resource.data.items is list
                        && request.resource.data.get('invs_sub_po_no', '') == '');

      allow update: if isAdmin()
                    || (ownsDept(resource.data.deptId)
                        && (resource.data.status == 'Pending' || resource.data.status == 'Rejected' || resource.data.status == 'Draft')
                        && (request.resource.data.status == 'Pending' || request.resource.data.status == 'Cancelled'
                            || (resource.data.status == 'Draft' && request.resource.data.status == 'Draft'))
                        && resource.data.get('invs_sub_po_no', '') == ''
                        && request.resource.data.get('invs_sub_po_no', '') == ''
                        && request.resource.data.get('invs_status', '') == resource.data.get('invs_status', '')
                        && request.resource.data.deptId == resource.data.deptId
                        && request.resource.data.kind == resource.data.kind
                        && request.resource.data.created_by_uid == resource.data.created_by_uid)
                    // v6.6 ผู้เบิกแก้ชื่อ/ตำแหน่งผู้ลงนามท้ายใบได้ทุกสถานะ (แตะได้เฉพาะ sign_people + เวลาแก้)
                    || (ownsDept(resource.data.deptId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sign_people', 'updated_at'])
                        && request.resource.data.sign_people is list
                        && request.resource.data.sign_people.size() <= 4);

      allow delete: if isAdmin();
    }

    // สต็อกคงเหลือโดยประมาณของห้องยา (นับเริ่มต้น / หักยอดใช้ / บวกเมื่ออนุมัติ)
    match /internal_stock/{docId} {
      allow read: if isAdmin() || ownsDept(resource.data.dept_id);

      allow create, update: if isAdmin()
                    || (isPharmacyUser()
                        && ownsDept(request.resource.data.dept_id)
                        && (resource == null || resource.data.dept_id == request.resource.data.dept_id)
                        && request.resource.data.drug_id is string
                        && request.resource.data.balance is number
                        && request.resource.data.balance >= 0);

      allow delete: if isAdmin();
    }

    // ===== v5.9 ยา NCDs ตามนัดจาก Sawee Refer =====
    // เขียนโดย service account ผ่าน Bridge/CLI เท่านั้น (ไม่มีข้อมูลผู้ป่วยรายบุคคล มีแค่ยอดรวม)
    match /ncds_demand_inbox/{docId} {
      allow read: if isAdmin() || ownsHospital(resource.data.get('hospital_id', ''));
      allow create, update, delete: if false;
    }

    // ===== v6.0 รอบเบิก (แอดมินกำหนดเลขรอบ/วันที่ต่อปีงบ) =====
    match /req_rounds/{roundId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ===== v6.2 ประหยัดโควตา =====
    // ป้ายลบ: ให้เครื่องอื่นลบเอกสารที่ถูกลบออกจากแคชในเครื่อง (มีแค่ชื่อคอลเลกชัน/รหัสเอกสาร)
    match /cache_tombstones/{docId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
                    && request.resource.data.keys().hasOnly(['col', 'doc_id', 'deleted_at', 'by'])
                    && request.resource.data.col is string
                    && request.resource.data.doc_id is string
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.deleted_at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ===== v6.2 แบบประเมินการใช้งาน =====
    match /feedback_rounds/{docId} {
      allow read, write: if isAdmin();
    }
    // รหัสเอกสาร = <round_id>__<uid> → 1 คน 1 คำตอบต่อรอบ
    match /feedback_responses/{docId} {
      allow get: if isAdmin() || (isActiveUser() && docId.matches('.*__' + request.auth.uid + '$'));
      allow list: if isAdmin();
      allow create, update: if isActiveUser()
                    && request.resource.data.uid == request.auth.uid
                    && docId == request.resource.data.round_id + '__' + request.auth.uid
                    && request.resource.data.overall is number
                    && request.resource.data.size() <= 30;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
